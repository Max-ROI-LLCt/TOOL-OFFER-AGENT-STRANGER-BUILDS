{
  "name": "tool-offer-fahce-checkout",
  "main": "checkout-worker.mjs",
  "compatibility_date": "2026-10-30",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [
    { "name": "CHECKOUTS", "class_name": "FahceCheckout" },
    { "name": "PAYMENT_RELAY", "class_name": "FahcePaymentRelay" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FahceCheckout"] },
    { "tag": "v2", "new_sqlite_classes": ["FahcePaymentRelay"] }
  ]
}
